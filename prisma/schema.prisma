generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MD
  CLERK
  PARENT
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMode {
  CASH
  ONLINE
}

enum PaymentMethod {
  CASH
  UPI
  NETBANKING
  CARD
  BANK_TRANSFER
}

enum PaymentSource {
  STAFF
  PARENT
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(CLERK)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  paymentsCollected Payment[]
  remindersSent     ReminderLog[]
  children          Student[]      @relation("ParentStudents")
  paymentOrders     PaymentOrder[]
}

model Class {
  id                 String    @id @default(cuid())
  name               String    // e.g. "Class 1", "Class 10"
  code               String    @unique // e.g. "C1", "C10"
  order              Int       @default(0)
  admissionFeePaise  Int       @default(600000)  // ₹6,000 default
  remainingFeePaise  Int       @default(3600000) // ₹36,000 default
  installmentCount   Int       @default(10)      // 10 monthly installments
  dueDayOfMonth      Int       @default(10)      // 10th of each month
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  students           Student[]

  @@index([order])
}

model Student {
  id            String        @id @default(cuid())
  admissionNo   String        @unique // e.g. "AVM-2026-001"
  name          String        // e.g. "Rohan Sharma"
  classId       String
  parentUserId  String?
  guardianName  String
  guardianPhone String
  address       String?
  admissionDate DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  class         Class         @relation(fields: [classId], references: [id])
  parentUser    User?         @relation("ParentStudents", fields: [parentUserId], references: [id], onDelete: SetNull)
  feePlans      FeePlan[]
  installments  Installment[]
  payments      Payment[]
  fines         Fine[]
  reminderLogs  ReminderLog[]
  paymentOrders PaymentOrder[]

  @@index([classId])
  @@index([parentUserId])
  @@index([admissionNo])
}

model FeePlan {
  id                String        @id @default(cuid())
  studentId         String        @unique
  admissionFeePaise Int
  remainingFeePaise Int
  installmentCount  Int           @default(10)
  dueDayOfMonth     Int           @default(10)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  installments      Installment[]
}

model Installment {
  id              String            @id @default(cuid())
  feePlanId       String
  studentId       String
  title           String            // e.g. "April 2026"
  monthIndex      Int               // 1 to 12
  monthName       String            // "April", "May", etc.
  dueDate         DateTime
  amountPaise     Int
  paidAmountPaise Int               @default(0)
  status          InstallmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  feePlan         FeePlan           @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations     PaymentAllocation[]
  fines           Fine[]
  reminderLogs    ReminderLog[]

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model PaymentOrder {
  id             String             @id @default(cuid())
  orderId        String             @unique // e.g. "order_123456"
  studentId      String
  parentUserId   String?
  amountPaise    Int
  status         PaymentOrderStatus @default(CREATED)
  installmentIds String             // Comma-separated or JSON list of installment IDs
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentUser     User?              @relation(fields: [parentUserId], references: [id], onDelete: SetNull)
  payment        Payment?

  @@index([orderId])
  @@index([studentId])
  @@index([parentUserId])
}

model Payment {
  id                String              @id @default(cuid())
  receiptNo         String              @unique // e.g. "REC-2026-001"
  studentId         String
  amountPaise       Int
  mode              PaymentMode         @default(CASH)
  method            PaymentMethod       @default(CASH)
  source            PaymentSource       @default(STAFF)
  txnRef            String?             // UTR / UPI Ref / Card Txn ID or Cash Note
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  paymentOrderId    String?             @unique
  paymentDate       DateTime            @default(now())
  remarks           String?
  collectedById     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  student           Student             @relation(fields: [studentId], references: [id])
  collectedBy       User?               @relation(fields: [collectedById], references: [id])
  paymentOrder      PaymentOrder?       @relation(fields: [paymentOrderId], references: [id])
  allocations       PaymentAllocation[]

  @@index([studentId])
  @@index([paymentDate])
  @@index([mode])
  @@index([method])
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  installmentId String
  amountPaise   Int         // Principal fee allocated
  finePaidPaise Int         @default(0)
  createdAt     DateTime    @default(now())

  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([installmentId])
}

model Fine {
  id            String      @id @default(cuid())
  installmentId String
  studentId     String
  amountPaise   Int         // Computed fine
  daysOverdue   Int         @default(0)
  isWaived      Boolean     @default(false)
  waiverReason  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@index([studentId])
}

model ReminderLog {
  id            String      @id @default(cuid())
  studentId     String
  installmentId String?
  message       String
  sentAt        DateTime    @default(now())
  sentById      String

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  sentBy        User        @relation(fields: [sentById], references: [id])

  @@index([studentId])
  @@index([sentAt])
}
